# Copy this file to .env and adjust values as needed.
BASE_URL=https://demo.playwright.dev/todomvc/

# Didaxis Studio
DIDAXIS_URL=https://test.didaxis.studio
DIDAXIS_EMAIL=your-email@college.edu
DIDAXIS_PASSWORD=your-password
# Bearer token for API cleanup (DevTools → Network after login; Authorization header)
DIDAXIS_API_TOKEN=your-bearer-token

# Manual bulk delete (scripts/delete-programs.ts): set to yes to allow delete without --confirm
# BULK_DELETE_CONFIRM=yes

# Optional: for DS-5 non-admin access test
# DIDAXIS_NONADMIN_EMAIL=student@college.edu
# DIDAXIS_NONADMIN_PASSWORD=your-password
